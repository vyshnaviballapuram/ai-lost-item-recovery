# Django Secret Key (Generate a random 50+ character string in production)
DJANGO_SECRET_KEY=your-production-django-secret-key-change-this

# Debug Mode (False in production)
DEBUG=False

# Allowed Hosts (comma-separated, include your Render app domain)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CSRF Trusted Origins (comma-separated, with scheme)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,https://*.onrender.com

# Database Connection URL (Render PostgreSQL internal/external connection string)
# Example: postgres://username:password@dpg-xxxxx.oregon-postgres.render.com/campus_db
DATABASE_URL=sqlite:///db.sqlite3

# AI Matching Engine Weights (Sum must equal 1.0)
AI_WEIGHT_TEXT=0.45
AI_WEIGHT_CATEGORY=0.20
AI_WEIGHT_ATTRIBUTES=0.15
AI_WEIGHT_LOCATION=0.10
AI_WEIGHT_DATE=0.10

# AI Review Threshold (0 - 100)
AI_MATCH_THRESHOLD=50.0

# Public Listings Policy Toggle
PUBLIC_REPORTS_ENABLED=True
